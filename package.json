{
  "name": "tron-mpp-sdk",
  "version": "0.1.0",
  "description": "MPP payment method SDK for TRON charge payments.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./tronweb": {
      "types": "./dist/tronweb/index.d.ts",
      "default": "./dist/tronweb/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client/index.ts src/server/index.ts src/tronweb/index.ts --format esm --dts --sourcemap --clean",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "mpp",
    "mppx",
    "tron",
    "trc20",
    "http-402",
    "payments"
  ],
  "license": "MIT",
  "peerDependencies": {
    "mppx": ">=0.8.3",
    "tronweb": ">=6.4.0",
    "viem": ">=2.54.0"
  },
  "peerDependenciesMeta": {
    "tronweb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "mppx": "^0.8.3",
    "tronweb": "^6.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "viem": "^2.54.0",
    "vitest": "^4.1.9"
  }
}
