{
  "name": "tron-mpp-sdk",
  "version": "0.1.0",
  "description": "MPP payment method SDK for TRON charge payments.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./tronweb": {
      "types": "./dist/tronweb/index.d.ts",
      "default": "./dist/tronweb/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/client/index.ts src/server/index.ts src/tronweb/index.ts --format esm --sourcemap --clean && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "keywords": [
    "mpp",
    "mppx",
    "tron",
    "trc20",
    "http-402",
    "payments"
  ],
  "license": "MIT",
  "peerDependencies": {
    "mppx": ">=0.15.0",
    "tronweb": ">=6.5.1",
    "viem": ">=2.57.12"
  },
  "peerDependenciesMeta": {
    "tronweb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "mppx": "^0.15.0",
    "tronweb": "^6.5.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "viem": "^2.57.12",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "tronweb": {
      "axios": "^1.20.0"
    },
    "follow-redirects": "^1.16.2"
  },
  "dependencies": {
    "@scure/base": "^2.4.0"
  }
}
